# ─────────────────────────────────────────────────────────
# Client Nurture OS — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# PostgreSQL — provided automatically by Railway Postgres plugin
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/client_nurture_os"

# AI Layer (optional — for live AI message generation)
ANTHROPIC_API_KEY=""

# Integrations (optional)
# Outlook OAuth — for sending emails directly from the app
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
